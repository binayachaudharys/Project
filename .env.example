APP_NAME="Pretty Girls Ladies Salon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
# On salon LAN, set to http://<this-pc-lan-ip>:8000 so phones hit the right host
APP_URL=http://localhost:8000

# Location profile: nepal | abudhabi (see config/locations.php and .env.abudhabi.example)
SALON_LOCATION=nepal
SALON_CURRENCY=Rs

SALON_NAME="Pretty Salon Nepal"
SALON_OPEN=10:00
SALON_CLOSE=19:00
SALON_SLOT_MINUTES=30
SALON_PACKAGE_DURATION=60
SALON_AUTO_CONFIRM=true
SALON_MAX_CONCURRENT=1
SALON_PAYMENT_SANDBOX_AUTO=true
SALON_ADDRESS="Shankhamul Pool, 3rd Floor (NIMB Building)"
SALON_PHONE="+977-9822783805"
SALON_WHATSAPP="9779822783805"
SALON_INSTAGRAM="https://www.instagram.com/prettysalonnepal/"
SALON_FACEBOOK="https://www.facebook.com/people/Pretty-Salon-Nepal/61584002914099/"
SALON_TIKTOK="https://www.tiktok.com/@prettysalonnepal"
SALON_PROMO="Grand opening offer — GET 30% OFF for the first month"
SALON_TAGLINE="A whole new you"

# eSewa — leave secrets empty; set locally. Sandbox reference (do not ship as defaults):
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET="8gBm/:&EnhH.1/q"
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_BASE_URL=https://merchantapi.fonepay.com/api/merchant/merchantDetailsForThirdParty

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
Owner
owner@prettygirls.local
ChangeMeOwner1!
Staff
staff@prettygirls.local
ChangeMeStaff1!
Customer
customer@prettygirls.local
ChangeMeCustomer1!

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite file: database/database.sqlite — backup by copying that file daily
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Log UI: opcodesio/log-viewer (Laravel 13). arcanedev/log-viewer has no L13 support.
# Owner-only role middleware is Task 3/8; routes require login via config/log-viewer.php.
LOG_VIEWER_ENABLED=true
# Design-doc placeholder (not used by opcodesio): web,auth,role:owner
ARCANEDEV_LOGVIEWER_MIDDLEWARE=web,auth,role:owner
