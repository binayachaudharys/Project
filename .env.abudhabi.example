# Pretty Salon Abu Dhabi — copy to .env on the Abu Dhabi deploy
# Same codebase as Nepal; only env + DB + domain change.
#
# TikTok: https://www.tiktok.com/@prettysalon_abudhabi

APP_NAME="Pretty Salon Abu Dhabi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dubai
APP_URL=https://your-abudhabi-domain.example

SALON_LOCATION=abudhabi
SALON_CURRENCY=AED
SALON_NAME="Pretty Salon Abu Dhabi"
SALON_TAGLINE="A whole new you"
SALON_OPEN=10:00
SALON_CLOSE=21:00
SALON_SLOT_MINUTES=30
SALON_PACKAGE_DURATION=60
SALON_AUTO_CONFIRM=true
SALON_MAX_CONCURRENT=1

# Fill real UAE contact details before go-live
SALON_ADDRESS="Abu Dhabi, UAE — street / building"
SALON_PHONE=""
SALON_WHATSAPP=""
SALON_INSTAGRAM=""
SALON_FACEBOOK=""
SALON_TIKTOK="https://www.tiktok.com/@prettysalon_abudhabi"
SALON_PROMO="Welcome to Pretty Salon Abu Dhabi"
SALON_LOGO=/images/logo.svg

# Use a separate database from Nepal (bookings, staff, prices stay local)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/abudhabi.sqlite

# UAE payment gateways — configure when ready (Nepal eSewa/Khalti can stay empty)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
